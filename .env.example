PORT=5000
DATABASE_URL=postgresql://your_db_user:your_db_password@localhost:5432/boarding_db
JWT_SECRET=your_jwt_secret_here_generate_a_64_char_hex_key
# JWT_EXPIRES_IN is no longer used — see ACCESS_TOKEN_EXPIRES_IN below
CORS_ORIGIN=https://your-frontend-domain.vercel.app
NODE_ENV=development
RCLONE_REMOTE=gdrive:BoardingFinder/listings
UPLOAD_TEMP_DIR=/tmp/boarding-uploads
SMTP_EMAIL=boardingfinder@kpfarm.org
BREVO_API_KEY=your_brevo_api_key_here

# ─── Sessions ───
# Access tokens are short-lived; refresh tokens live in an HTTP-only cookie.
ACCESS_TOKEN_EXPIRES_IN=15m
REFRESH_TOKEN_DAYS=30

# ─── Private document storage (rclone remote, no public links) ───
RCLONE_VERIFICATION_REMOTE=gdrive:BoardingFinder/verifications

# Payments are Cash on Move-in only — no payment gateway is used.
# Public URL of this API (used in iCal calendar export links)
API_PUBLIC_URL=https://api.your-domain.com
# Public URL of the frontend (used in email links, e.g. password reset)
FRONTEND_URL=https://your-frontend-domain.vercel.app

# ─── Password reset emails ───
# (uses BREVO_API_KEY / SMTP_EMAIL above; links point at FRONTEND_URL)

# ─── Optional SMS alerts for urgent events (Twilio) ───
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
SMS_DEFAULT_COUNTRY_CODE=94
